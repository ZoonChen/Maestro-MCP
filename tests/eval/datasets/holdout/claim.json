      },
      "inputs": {
        "task": "长时维护：跨多个心跳周期完成一次带验证的修复（租约不丢、预算不爆）"
      },
      "allowed_tools": [
        "claim_targeted",
        "heartbeat_lease",
        "read_file",
        "apply_edit",
        "run_tests",
        "create_mr"
      ],
      "forbidden_actions": [
        "write_outside_workspace"
      ],
      "expected_outcome": {
        "lease_maintained": true,
        "tests_passed": true,
        "mr_created": true
      },
      "trajectory_constraints": [
        "must_use:heartbeat_lease",
        "max_tool_calls<=12"
      ],
      "budget": {
        "trials": 3,
        "timeout_ms": 180000,
        "max_tool_calls": 12
      },
      "scorer": {
        "kind": "rule_based",
        "version": "1.0.0"
      },
      "version": 1
