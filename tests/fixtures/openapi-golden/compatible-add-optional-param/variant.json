{
  "openapi": "3.0.3",
  "info": {
    "title": "orders",
    "version": "1.0.0"
  },
  "paths": {
    "/orders": {
      "get": {
        "summary": "list orders",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "number"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "open",
                        "paid"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "missing"
          }
        }
      },
      "post": {
        "summary": "create order",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "amount"
                ],
                "properties": {
                  "amount": {
                    "type": "number"
                  },
                  "currency": {
                    "type": "string",
                    "enum": [
                      "CNY",
                      "USD"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created"
          }
        }
      }
    }
  }
}
