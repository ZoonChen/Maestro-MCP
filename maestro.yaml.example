# Maestro MCP Configuration
# Copy this file to maestro.yaml and edit as needed.
# All values can be overridden via environment variables (see below).

# Database path (SQLite). Use ":memory:" for testing.
db_path: "data/maestro.db"
# Env override: MAESTRO_DB_PATH

# HTTP server address (REST API + WebSocket + Web UI + Streamable HTTP MCP).
# M0 defaults to loopback. Bind 0.0.0.0 only inside an explicitly protected
# container/network.
http_addr: "127.0.0.1:8080"
# Env override: MAESTRO_HTTP_ADDR

# Remote MCP is served at /mcp on the HTTP address. The local Runner uses
# stdio via: maestro runner --config maestro.yaml --runner-id <id>

# Maximum concurrent HTTP/MCP/WebSocket connections.
max_connections: 50

# Logging configuration
log_level: "info"    # debug, info, warn, error
log_format: "text"   # text or json (structured logging)

# Session stale timeout in seconds (heartbeat interval threshold)
# Sessions that don't send a heartbeat within this period are marked offline.
stale_timeout_sec: 120

# Garbage collection intervals
worktree_gc_interval_sec: 600  # 10 minutes - cleans up abandoned/merged worktrees
data_gc_interval_hours: 24     # 24 hours - purges old activity and external validation logs

# Data retention periods (in days)
activity_log_retention_days: 90
# Audit rows are append-only. This fixed value governs export/backup retention;
# it never authorizes runtime deletion.
audit_log_retention_days:    365

# Authentication — Bearer token for REST, MCP, WebSocket and Web UI.
# Do not put the token in this file. An empty token fails closed: only /livez,
# /readyz and the deprecated /health compatibility probe remain reachable.
#   export MAESTRO_AUTH_TOKEN="your-secure-random-token"

# Browser and WebSocket Origins are exact matches. An empty allowlist permits
# only same-origin requests.
allowed_origins: ["http://127.0.0.1:8080"]
# Env override (comma-separated): MAESTRO_ALLOWED_ORIGINS

# Remote mutations are disabled throughout the M0 development baseline.
remote_write: false
# Env override: MAESTRO_REMOTE_WRITE (must remain false outside explicit tests)

# ---------------------------------------------------------------------------
# M1 v3 sections (contract frozen by the I1 contract-freeze sprint). Each is
# optional; the sections below are commented examples for the Compose
# topology (docker compose --profile m1 up).
# ---------------------------------------------------------------------------

# Dual-driver database section. Omitted = M0 SQLite via db_path above.
# database:
#   driver: postgres                      # sqlite | postgres; empty infers from dsn presence
#   dsn_secret_ref: "docker-secret://maestro-postgres-dsn"
#   max_open_connections: 20              # 2..100 per config.schema.json
# Env overrides: MAESTRO_DB_DRIVER, MAESTRO_DATABASE_DSN_REF,
#   MAESTRO_DATABASE_DSN (resolved secret value, never in this file),
#   MAESTRO_DATABASE_MAX_OPEN_CONNECTIONS

# OIDC Authorization Code + PKCE identity source (M1-AUTH-001 wires it).
# oidc:
#   issuer: "https://keycloak:8443/realms/maestro"
#   client_id: "maestro-control-plane"
#   client_secret_ref: "docker-secret://maestro-oidc-client-secret"
#   audience: "maestro"
#   access_token_ttl_seconds: 900         # fixed by the machine schema
# Env overrides: MAESTRO_OIDC_ISSUER, MAESTRO_OIDC_CLIENT_ID,
#   MAESTRO_OIDC_CLIENT_SECRET_REF, MAESTRO_OIDC_AUDIENCE,
#   MAESTRO_OIDC_CLIENT_SECRET (resolved value)

# Runner protocol windows. heartbeat/suspect/offline/enrollment are frozen
# constants (15/45/90/600 seconds); only lease_ttl_seconds (30..600) and
# long_poll_seconds (1..30) are operator-tunable. Defaults shown.
# runner:
#   enrollment_ttl_seconds: 600
#   lease_ttl_seconds: 90
#   long_poll_seconds: 25
#   heartbeat_seconds: 15
#   suspect_seconds: 45
#   offline_seconds: 90

# Zero-trust validation runtime. The safe default has no approved profiles and
# cannot execute on the host, so task submission fails closed. Unlike ordinary
# runtime settings, these values intentionally have no environment overrides.
validation:
  allow_host_execution: false
  default_timeout_sec: 120
  max_output_bytes: 65536
  policy_version: ""
  policy_digest: ""
  command_profiles: []

# Transitional M0 local-only example (keep remote_write=false and bind an
# explicit loopback IP). argv is an array passed directly to exec; shell
# interpreters and arbitrary request-provided commands are rejected. Replace
# both immutable digests with approved values before enabling.
# validation:
#   allow_host_execution: true
#   default_timeout_sec: 120
#   max_output_bytes: 65536
#   policy_version: "3.0.0-m0-local"
#   policy_digest: "sha256:<64 lowercase hex characters>"
#   command_profiles:
#     - id: "go-m0-test"
#       version: "3.0.0"
#       image_digest: "sha256:<64 lowercase hex characters>"
#       argv: ["go", "test", "./..."]
#       working_directory: "."
#       network:
#         mode: "none"
#         allow_hosts: []
#       resources:
#         cpu_millis: 2000
#         memory_mb: 2048
#         disk_mb: 4096
#         pids: 256
#       output_limit_bytes: 65536
#       timeout_seconds: 120
