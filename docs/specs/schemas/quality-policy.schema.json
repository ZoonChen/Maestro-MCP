{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.internal/schemas/quality-policy-v3.json",
  "title": "Maestro Quality Policy",
  "$defs": {
    "producer_kind": {
      "title": "Evidence producer kind",
      "description": "D1 producer-kind declaration: every gate's evidence comes from a declared kind of producer. pipeline_job = a CI job named after the gate kind (GitLab ingestion); control_plane = the evaluation engine's own deterministic judgment. The gate-to-kind assignment below is the frozen contract the engine enforces on evidence acceptance.",
      "type": "string",
      "enum": ["pipeline_job", "control_plane"]
    },
    "gate_producer_kinds": {
      "title": "Gate → producer kinds (frozen oracle assignment)",
      "description": "policy_integrity/baseline_freshness/boundary are engine-oracle gates: their guaranteed producer is the control_plane self-attestation (CI-named jobs may complement, never replace it). All other gates are CI gates: pipeline_job producers only.",
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "enum": [
          "baseline_freshness",
          "boundary",
          "policy_integrity",
          "build",
          "unit",
          "lint_typecheck",
          "coverage",
          "integration",
          "contract",
          "secret_scan",
          "sast",
          "dependency",
          "image",
          "license"
        ]
      },
      "properties": {
        "baseline_freshness": {"const": ["pipeline_job", "control_plane"]},
        "boundary": {"const": ["pipeline_job", "control_plane"]},
        "policy_integrity": {"const": ["pipeline_job", "control_plane"]},
        "build": {"const": ["pipeline_job"]},
        "unit": {"const": ["pipeline_job"]},
        "lint_typecheck": {"const": ["pipeline_job"]},
        "coverage": {"const": ["pipeline_job"]},
        "integration": {"const": ["pipeline_job"]},
        "contract": {"const": ["pipeline_job"]},
        "secret_scan": {"const": ["pipeline_job"]},
        "sast": {"const": ["pipeline_job"]},
        "dependency": {"const": ["pipeline_job"]},
        "image": {"const": ["pipeline_job"]},
        "license": {"const": ["pipeline_job"]}
      }
    },
    "capability_key": {
      "title": "Capability key",
      "description": "The frozen namespace.key identifiers of the capability catalog (D2). A project opts into a capability gate by declaring its key — always together with the producer anchor.",
      "type": "string",
      "enum": [
        "quality.coverage",
        "quality.lint",
        "supply-chain.license",
        "security.sast",
        "supply-chain.dependency",
        "supply-chain.image",
        "integration.enabled",
        "contract.openapi"
      ]
    },
    "capability_producer": {
      "title": "Capability producer anchor",
      "description": "Declaring a capability means declaring its producer (the F14 structural rule): every declaration MUST anchor the concrete CI producer — the repository and the gate-named job. A key-only declaration is rejected.",
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "job"],
      "properties": {
        "repo": {"type": "string", "minLength": 1, "maxLength": 512},
        "job": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "scope", "required_gates", "coverage", "security", "flaky_retry_count", "waiver"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "scope": {"enum": ["company", "project", "task"]},
    "extends": {"type": ["string", "null"]},
    "required_gates": {
      "title": "Core gates (tier 1 — unconditional)",
      "description": "The six core gates every policy must require: each has a guaranteed producer (CI pipeline jobs for build/unit/secret_scan; the D1 control-plane self-attestation for the three engine-oracle gates). Capability-catalog gates may appear here only when the same document declares the capability.",
      "type": "array",
      "uniqueItems": true,
      "minItems": 6,
      "items": {
        "enum": [
          "baseline_freshness",
          "boundary",
          "policy_integrity",
          "build",
          "unit",
          "lint_typecheck",
          "coverage",
          "integration",
          "contract",
          "secret_scan",
          "sast",
          "dependency",
          "image",
          "license"
        ]
      },
      "allOf": [
        {"contains": {"const": "build"}},
        {"contains": {"const": "unit"}},
        {"contains": {"const": "secret_scan"}},
        {"contains": {"const": "policy_integrity"}},
        {"contains": {"const": "baseline_freshness"}},
        {"contains": {"const": "boundary"}}
      ]
    },
    "capability_gates": {
      "title": "Capability gates (tier 2 — declaration-gated catalog)",
      "description": "The frozen company catalog: a gate here is required ONLY for projects that declare its capability_key (with a producer anchor). Entries and their gate↔capability↔producer-kind pairing are const — integration and contract are folded into this mechanism, ending the document-level special cases.",
      "type": "array",
      "uniqueItems": true,
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "capability_key", "producer_kind"],
        "properties": {
          "gate_id": {
            "enum": ["coverage", "lint_typecheck", "license", "sast", "dependency", "image", "integration", "contract"]
          },
          "capability_key": {"$ref": "#/$defs/capability_key"},
          "producer_kind": {"$ref": "#/$defs/producer_kind"}
        }
      },
      "allOf": [
        {"contains": {"const": {"gate_id": "coverage", "capability_key": "quality.coverage", "producer_kind": "pipeline_job"}}},
        {"contains": {"const": {"gate_id": "lint_typecheck", "capability_key": "quality.lint", "producer_kind": "pipeline_job"}}},
        {"contains": {"const": {"gate_id": "license", "capability_key": "supply-chain.license", "producer_kind": "pipeline_job"}}},
        {"contains": {"const": {"gate_id": "sast", "capability_key": "security.sast", "producer_kind": "pipeline_job"}}},
        {"contains": {"const": {"gate_id": "dependency", "capability_key": "supply-chain.dependency", "producer_kind": "pipeline_job"}}},
        {"contains": {"const": {"gate_id": "image", "capability_key": "supply-chain.image", "producer_kind": "pipeline_job"}}},
        {"contains": {"const": {"gate_id": "integration", "capability_key": "integration.enabled", "producer_kind": "pipeline_job"}}},
        {"contains": {"const": {"gate_id": "contract", "capability_key": "contract.openapi", "producer_kind": "pipeline_job"}}}
      ]
    },
    "capabilities": {
      "title": "Declared capabilities (project overlay opt-ins)",
      "description": "A project overlay's capability declarations: each names a cataloged key and MUST carry the producer anchor. Declaring the capability opts the project into the matching capability gate; the declaration and the gate listing are inseparable in both directions.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "producer"],
        "properties": {
          "capability": {"$ref": "#/$defs/capability_key"},
          "producer": {"$ref": "#/$defs/capability_producer"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_lines_min_percent", "max_total_drop_points"],
      "properties": {
        "changed_lines_min_percent": {"type": "number", "minimum": 80, "maximum": 100},
        "max_total_drop_points": {"type": "number", "minimum": 0, "maximum": 0.5}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_severities", "license_denylist"],
      "properties": {
        "block_severities": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["critical", "high", "medium", "low"]},
          "allOf": [
            {"contains": {"const": "critical"}},
            {"contains": {"const": "high"}}
          ]
        },
        "license_denylist": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "flaky_retry_count": {"type": "integer", "const": 1},
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_days", "requires_distinct_approver", "non_waivable_gates"],
      "properties": {
        "max_days": {"type": "integer", "const": 7},
        "requires_distinct_approver": {"const": true},
        "non_waivable_gates": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "enum": [
              "identity_isolation",
              "sha_integrity",
              "policy_integrity",
              "webhook_authenticity"
            ]
          },
          "allOf": [
            {"contains": {"const": "identity_isolation"}},
            {"contains": {"const": "sha_integrity"}},
            {"contains": {"const": "policy_integrity"}},
            {"contains": {"const": "webhook_authenticity"}}
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "title": "Company scope owns the catalog, carries no declarations",
      "if": {"properties": {"scope": {"const": "company"}}, "required": ["scope"]},
      "then": {
        "required": ["capability_gates"],
        "properties": {
          "required_gates": {"maxItems": 6},
          "capabilities": false
        }
      }
    },
    {
      "title": "A project/task overlay inherits the catalog at resolution",
      "if": {"properties": {"scope": {"enum": ["project", "task"]}}, "required": ["scope"]},
      "then": {
        "properties": {"capability_gates": false}
      }
    },
    {
      "title": "A capability gate in required_gates implies its declaration (anti-F14, forward)",
      "if": {"required": ["required_gates"], "properties": {"required_gates": {"contains": {"const": "coverage"}}}},
      "then": {"required": ["capabilities"], "properties": {"capabilities": {"contains": {"properties": {"capability": {"const": "quality.coverage"}}, "required": ["capability"]}}}}
    },
    {
      "if": {"required": ["required_gates"], "properties": {"required_gates": {"contains": {"const": "lint_typecheck"}}}},
      "then": {"required": ["capabilities"], "properties": {"capabilities": {"contains": {"properties": {"capability": {"const": "quality.lint"}}, "required": ["capability"]}}}}
    },
    {
      "if": {"required": ["required_gates"], "properties": {"required_gates": {"contains": {"const": "license"}}}},
      "then": {"required": ["capabilities"], "properties": {"capabilities": {"contains": {"properties": {"capability": {"const": "supply-chain.license"}}, "required": ["capability"]}}}}
    },
    {
      "if": {"required": ["required_gates"], "properties": {"required_gates": {"contains": {"const": "sast"}}}},
      "then": {"required": ["capabilities"], "properties": {"capabilities": {"contains": {"properties": {"capability": {"const": "security.sast"}}, "required": ["capability"]}}}}
    },
    {
      "if": {"required": ["required_gates"], "properties": {"required_gates": {"contains": {"const": "dependency"}}}},
      "then": {"required": ["capabilities"], "properties": {"capabilities": {"contains": {"properties": {"capability": {"const": "supply-chain.dependency"}}, "required": ["capability"]}}}}
    },
    {
      "if": {"required": ["required_gates"], "properties": {"required_gates": {"contains": {"const": "image"}}}},
      "then": {"required": ["capabilities"], "properties": {"capabilities": {"contains": {"properties": {"capability": {"const": "supply-chain.image"}}, "required": ["capability"]}}}}
    },
    {
      "if": {"required": ["required_gates"], "properties": {"required_gates": {"contains": {"const": "integration"}}}},
      "then": {"required": ["capabilities"], "properties": {"capabilities": {"contains": {"properties": {"capability": {"const": "integration.enabled"}}, "required": ["capability"]}}}}
    },
    {
      "if": {"required": ["required_gates"], "properties": {"required_gates": {"contains": {"const": "contract"}}}},
      "then": {"required": ["capabilities"], "properties": {"capabilities": {"contains": {"properties": {"capability": {"const": "contract.openapi"}}, "required": ["capability"]}}}}
    }
  ],
  "examples": [
    {
      "id": "company-baseline",
      "version": "3.1.0",
      "scope": "company",
      "required_gates": ["build", "unit", "secret_scan", "policy_integrity", "baseline_freshness", "boundary"],
      "capability_gates": [
        {"gate_id": "coverage", "capability_key": "quality.coverage", "producer_kind": "pipeline_job"},
        {"gate_id": "lint_typecheck", "capability_key": "quality.lint", "producer_kind": "pipeline_job"},
        {"gate_id": "license", "capability_key": "supply-chain.license", "producer_kind": "pipeline_job"},
        {"gate_id": "sast", "capability_key": "security.sast", "producer_kind": "pipeline_job"},
        {"gate_id": "dependency", "capability_key": "supply-chain.dependency", "producer_kind": "pipeline_job"},
        {"gate_id": "image", "capability_key": "supply-chain.image", "producer_kind": "pipeline_job"},
        {"gate_id": "integration", "capability_key": "integration.enabled", "producer_kind": "pipeline_job"},
        {"gate_id": "contract", "capability_key": "contract.openapi", "producer_kind": "pipeline_job"}
      ],
      "coverage": {"changed_lines_min_percent": 80, "max_total_drop_points": 0.5},
      "security": {"block_severities": ["critical", "high"], "license_denylist": ["AGPL-3.0-only"]},
      "flaky_retry_count": 1,
      "waiver": {
        "max_days": 7,
        "requires_distinct_approver": true,
        "non_waivable_gates": ["identity_isolation", "sha_integrity", "policy_integrity", "webhook_authenticity"]
      }
    },
    {
      "id": "acme-overlay",
      "version": "1.0.0",
      "scope": "project",
      "extends": "company-baseline",
      "required_gates": ["build", "unit", "secret_scan", "policy_integrity", "baseline_freshness", "boundary", "coverage"],
      "capabilities": [
        {"capability": "quality.coverage", "producer": {"repo": "acme/backend", "job": "coverage"}}
      ],
      "coverage": {"changed_lines_min_percent": 85, "max_total_drop_points": 0.3},
      "security": {"block_severities": ["critical", "high", "medium"], "license_denylist": ["AGPL-3.0-only"]},
      "flaky_retry_count": 1,
      "waiver": {
        "max_days": 7,
        "requires_distinct_approver": true,
        "non_waivable_gates": ["identity_isolation", "sha_integrity", "policy_integrity", "webhook_authenticity"]
      }
    }
  ]
}
