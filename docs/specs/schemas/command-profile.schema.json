{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maestro.internal/schemas/command-profile-v3.json",
  "title": "Runner Command Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "image_digest",
    "argv",
    "working_directory",
    "network",
    "resources",
    "output_limit_bytes",
    "timeout_seconds"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "prefixItems": [
        {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^(?!.*(?:^|/)(?:sh|bash|zsh|fish|cmd|powershell|pwsh)$)[^\\u0000]+$"
        }
      ],
      "items": {"type": "string", "maxLength": 1024, "pattern": "^[^\\u0000]*$"}
    },
    "working_directory": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._/-]+$",
      "not": {"pattern": "(^/|\\.\\.|\\u0000)"}
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allow_hosts"],
      "properties": {
        "mode": {"enum": ["none", "allowlist"]},
        "allow_hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "format": "hostname"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "none"}}},
          "then": {"properties": {"allow_hosts": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"mode": {"const": "allowlist"}}},
          "then": {"properties": {"allow_hosts": {"minItems": 1, "maxItems": 32}}}
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_millis", "memory_mb", "disk_mb", "pids"],
      "properties": {
        "cpu_millis": {"type": "integer", "minimum": 100, "maximum": 8000},
        "memory_mb": {"type": "integer", "minimum": 128, "maximum": 16384},
        "disk_mb": {"type": "integer", "minimum": 128, "maximum": 51200},
        "pids": {"type": "integer", "minimum": 16, "maximum": 2048}
      }
    },
    "output_limit_bytes": {"type": "integer", "minimum": 1024, "maximum": 10485760},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "environment": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "propertyNames": {
        "not": {"pattern": "([Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Kk][Ee][Yy])$"}
      }
    }
  },
  "examples": [
    {
      "id": "go-unit",
      "version": "3.0.0",
      "image_digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "argv": ["go", "test", "./..."],
      "working_directory": ".",
      "network": {"mode": "none", "allow_hosts": []},
      "resources": {"cpu_millis": 2000, "memory_mb": 2048, "disk_mb": 4096, "pids": 256},
      "output_limit_bytes": 1048576,
      "timeout_seconds": 900,
      "environment": {"CI": "true"}
    }
  ]
}
